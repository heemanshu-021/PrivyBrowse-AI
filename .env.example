# =================================================================
# PrivyBrowse AI — Production Environment Configuration Example
# Copy this file to .env and adjust values for your deployment.
# =================================================================

# 1. Environment Mode: 'production' | 'development' | 'test'
PRIVYBROWSE_ENV=production

# 2. Network Host & Port Binding
# Bind to 127.0.0.1 for local privacy-preserving execution
PRIVYBROWSE_HOST=127.0.0.1
PRIVYBROWSE_PORT=8000

# 3. Allowed Origins (CORS) — Comma-separated list
PRIVYBROWSE_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173,chrome-extension://*

# 4. Simulation Mode Isolation
# WARNING: Keep 'false' for production execution with real browser extension.
# Set 'true' ONLY for isolated offline testing or deterministic CI harnesses.
PRIVYBROWSE_SIMULATION_MODE=false

# 5. OCR Configuration
# Optional explicit path to Tesseract binary (if not in system PATH)
# e.g., /usr/local/bin/tesseract or /opt/homebrew/bin/tesseract
# If omitted or binary is not found, PrivyBrowse automatically activates DOM_TEXT_PROXY fallback.
# TESSERACT_CMD=/usr/local/bin/tesseract

# 6. Logging & Observability
# 'DEBUG' | 'INFO' | 'WARNING' | 'ERROR'
PRIVYBROWSE_LOG_LEVEL=INFO
